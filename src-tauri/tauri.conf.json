{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clav.Strats",
  "version": "1.0.0",
  "identifier": "com.clavstrats.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clav.Strats",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "backgroundColor": "#080A0E",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zCrxticxl/clav-strats/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRTVEMTY5QTU1RjUwQjMKUldTelVGK2xhZEhsSHlYQmZDZTVHN1pkUWk3dmRaT2hGQzc2ZDdDbDZmNnBpRVdqbDgzSURkejIK"
    }
  }
}
