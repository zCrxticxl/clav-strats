{
  "name": "clav-strats",
  "version": "1.0.4",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "react-scripts": "5.0.1",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "ws": "^8.17.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "electron": "electron .",
    "collab": "node collab/server.js",
    "dist": "react-scripts build && electron-builder --win --x64",
    "tauri": "tauri",
    "verify:updater": "node scripts/verify-updater-release.mjs"
  },
  "build": {
    "appId": "com.clavstrats.app",
    "productName": "Clav.Strats",
    "asar": false,
    "files": [
      "build/**/*",
      "public/electron.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "protocols": [
      {
        "name": "Clav.Strats Deep Link",
        "schemes": [
          "clavstrats"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
