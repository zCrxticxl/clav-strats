{
  "name": "clav-strats",
  "version": "1.0.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron:dev": "BROWSER=none react-scripts start & sleep 5 && electron .",
    "dist": "react-scripts build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.0.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "build": {
    "appId": "com.clav.strats",
    "productName": "Clav Strats",
    "files": ["build/**/*", "public/electron.js", "public/icons/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" }
  }
}
