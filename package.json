{
  "name": "clav-strats",
  "version": "1.1.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "nth-check": "2.1.1",
    "postcss": "8.5.26",
    "serialize-javascript": "7.0.5",
    "svgo": "2.8.3",
    "underscore": "1.13.8",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2",
    "gif.js": "^0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.3",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-jest": "^29.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^7.3.6"
  },
  "scripts": {
    "prestart": "node scripts/prepare-gif-worker.mjs",
    "start": "vite",
    "prebuild": "node scripts/prepare-gif-worker.mjs",
    "build": "vite build",
    "test": "jest",
    "electron": "electron .",
    "collab": "node collab/server.js",
    "dist": "npm run build && electron-builder --win --x64",
    "tauri": "tauri",
    "verify:updater": "node scripts/verify-updater-release.mjs"
  },
  "build": {
    "appId": "com.clavstrats.app",
    "productName": "Clav.Strats",
    "asar": false,
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/favicon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Clav.Strats Deep Link",
        "schemes": [
          "clavstrats"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
